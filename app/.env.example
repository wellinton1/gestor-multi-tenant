# =============================================================================
# CONFIGURACAO DE PRODUCAO - Gere valores unicos e seguros para cada deploy
# =============================================================================

# Ambiente: 'production' ou 'development'
NODE_ENV=production

# Porta do servidor (padrao: 3000)
PORT=3000

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL) - OBRIGATORIO
# -----------------------------------------------------------------------------
# Sem esta variavel o servidor NAO inicia.
#   Windows (PG embutido no projeto): use a senha definida no primeiro boot.
#   Linux/VPS: o scripts/install.sh cria usuario/banco e preenche automaticamente.
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=postgres://gestor:troque-esta-senha@127.0.0.1:5432/gestor

# Somente Windows (PG embutido): superusuario e caminho dos binarios.
# No Linux, use o PostgreSQL do sistema e NAO defina PG_BIN.
# PG_SUPER_USER=postgres
# PG_SUPER_PASSWORD=
# PG_BIN=C:\caminho\para\pgsql\bin

# -----------------------------------------------------------------------------
# SEGREDOS CRITICOS - NUNCA COMMITE ESTE ARQUIVO
# Gere valores seguros com: openssl rand -hex 64
# -----------------------------------------------------------------------------

# Chave secreta para assinar cookies de sessao (MINIMO 32 caracteres hex, 64 recomendado)
# Gere com: openssl rand -hex 64
SESSION_SECRET=your-64-char-hex-secret-here

# Senha do administrador inicial (OPCIONAL).
# Se deixar vazio, nenhum admin sera criado pelo .env. Na primeira vez que o
# sistema for aberto no navegador aparecera a tela de Setup pedindo nome,
# email e senha do administrador (mais seguro - a senha nao fica no .env).
# Se preencher,MINIMO 12 caracteres em producao, use gerador de senhas.
# Gere com: openssl rand -base64 32
ADMIN_PASSWORD=

# Email do administrador inicial (usado apenas se ADMIN_PASSWORD estiver definido)
ADMIN_EMAIL=admin@seu-dominio.com

# Nome do administrador inicial (usado apenas se ADMIN_PASSWORD estiver definido)
ADMIN_NAME=Administrador

# -----------------------------------------------------------------------------
# CONFIGURACOES DE SEGURANCA DE COOKIE
# -----------------------------------------------------------------------------

# Deve ser 'true' em producao com HTTPS. 'false' apenas para desenvolvimento local HTTP.
COOKIE_SECURE=true

# SameSite do cookie de sessao: 'lax' (padrao, obrigatorio p/ login Google funcionar), 'strict', ou 'none' (requer Secure)
COOKIE_SAME_SITE=lax

# -----------------------------------------------------------------------------
# RATE LIMITING (ajuste conforme necessidade)
# -----------------------------------------------------------------------------

# Max requisicoes por IP por janela de 15min (global)
RATE_LIMIT_GLOBAL_MAX=200

# Max tentativas de alteracao de senha por IP por hora
RATE_LIMIT_PASSWORD_MAX=6

# Max requisicoes de agendamento publico por IP por hora
RATE_LIMIT_PORTAL_MAX=30

# -----------------------------------------------------------------------------
# BCRYPT & SENHAS
# -----------------------------------------------------------------------------

# Rounds de bcrypt (10-12 recomendado). Maior = mais seguro mas mais lento.
BCRYPT_ROUNDS=12

# Forcar troca de senha no primeiro login (true/false)
FORCE_PASSWORD_CHANGE=true

# Senha para operadores de demonstracao (apenas se SEED_DEMO_DATA=true)
# Deixe vazio para nao criar usuarios demo
DEMO_OPERATOR_PASSWORD=

# -----------------------------------------------------------------------------
# DADOS DE DEMONSTRACAO
# -----------------------------------------------------------------------------

# Criar dados de exemplo na primeira execucao? 'true' ou 'false'
# ATENCAO: Cria usuarios com senhas conhecidas. Use APENAS em desenvolvimento/staging.
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# BACKUPS (site inteiro em .zip, em app/data/backups)
# -----------------------------------------------------------------------------

# Backup automatico a cada periodo? 'true' ou 'false' (padrao: true)
BACKUP_AUTO_ENABLED=true

# Intervalo do backup automatico, em horas (padrao: 6)
BACKUP_INTERVAL_HOURS=6

# Quantidade maxima de backups automaticos mantidos (os mais antigos sao apagados; padrao: 30)
BACKUP_MAX_FILES=30

# -----------------------------------------------------------------------------
# ISOLAMENTO ENTRE TENANTS (Row-Level Security no PostgreSQL)
# -----------------------------------------------------------------------------

# Camada extra de isolamento no banco: cada tabela de loja ganha policy RLS e
# o app configura o tenant da transacao automaticamente. Padrao: true.
# Use 'false' apenas para diagnostico emergencial (o filtro na aplicacao
# continua ativo, mas perde-se a segunda barreira no banco).
RLS_ENABLED=true

# -----------------------------------------------------------------------------
# BANCOS DEDICADOS POR TENANT (Nivel 2 — opcional, ver docs/TENANT_SCALING.md §4)
# -----------------------------------------------------------------------------
# Mapa JSON establishmentId -> DATABASE_URL do banco dedicado da loja.
# Roteamento automatico: leituras/escritas do tenant vao para o banco proprio
# (schema+RLS aplicados no boot); `users` continua global no banco padrao.
# Migracao: node scripts/migrate-tenant-db.js <estId> <targetUrl> --create-db
# Ex.: TENANT_DATABASE_OVERRIDES='{"abc123":"postgres://gestor:senha@127.0.0.1:5432/gestor_lojaX"}'
# TENANT_DATABASE_OVERRIDES=
#
# AUTOMATICO (1 clique no painel, sem editar nada):
# o mapa tenant->banco persiste em data/tenant-databases.json (entra no backup).
# Prefixo dos bancos criados sozinhos (ex.: gestor_t_<id>):
# TENANT_DB_PREFIX=gestor_t_
# Migracao automatica por volume (desligado por padrao; a cada 24h migra lojas
# compartilhadas com agendamentos >= limite):
# TENANT_AUTO_PROVISION=false
# TENANT_AUTO_MIN_APPOINTMENTS=50000

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (login "Continuar com Google")
# -----------------------------------------------------------------------------
# Pegue no Google Cloud Console (APIs & Services > Credentials > OAuth client ID).
# O "Authorized redirect URI" cadastrado no Google PRECISA ser igual ao
# GOOGLE_REDIRECT_URI abaixo (incluindo porta).
# Sem estas 3 vars o botao Google fica oculto e /api/auth/google retorna 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# -----------------------------------------------------------------------------
# RECUPERACAO DE SENHA POR EMAIL (forgot-password)
# -----------------------------------------------------------------------------
# Sem SMTP configurado o POST /api/auth/forgot-password so registra no log
# (e em dev retorna devToken no JSON). Com SMTP, envia o link de reset.
# Ex. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false,
# SMTP_USER=voce@gmail.com, SMTP_PASS=<senha de app>, SMTP_FROM="Painel <voce@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# URL publica usada para montar o link do email de reset (IP ou dominio real).
# Ex.: APP_BASE_URL=http://18.218.26.112:3000  ou  https://painel.seudominio.com
APP_BASE_URL=http://localhost:3000
# Validade do token de reset em horas (padrao: 2).
PASSWORD_RESET_EXPIRES_HOURS=2

# -----------------------------------------------------------------------------
# OPCIONAIS
# -----------------------------------------------------------------------------

# Habilitar logs de debug (true/false)
DEBUG=false